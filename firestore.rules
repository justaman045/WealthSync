rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    function isAdmin() {
      let adminDoc = get(/databases/$(database)/documents/users/$(request.auth.token.email));
      return request.auth != null
          && adminDoc != null
          && adminDoc.data != null
          && adminDoc.data.isAdmin == true;
    }

    function validTrialCap(ts) {
      return ts is timestamp
          && ts.toMillis() - request.time.toMillis() <= (45 * 24 * 60 * 60 * 1000);
    }

    // A doc write may only claim 'pro' via a recorded Google Play purchase
    // (true purchase verification requires a Cloud Function).
    function validProClaim(d) {
      return d.subscriptionStatus == 'pro'
          && d.purchaseToken is string
          && d.purchaseToken.size() > 0;
    }

    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasAll(['amount', 'date', 'senderId', 'recipientId'])
          && d.amount is number
          && d.date is timestamp;
    }

    // Owner update of their own profile. Blocks self-admin and self-referral
    // spoofing. Trial end may not be pushed unreasonably far into the future.
    // 'pro' status can only be claimed via a recorded Google Play purchase
    // (true purchase verification requires a Cloud Function; this closes the
    // naive "write subscriptionStatus: pro" self-grant hole). The parallel
    // `isPro` flag is also gated: it may only be set true alongside a valid
    // pro claim (closing the "write isPro: true" self-grant hole), while the
    // app's own cancel/expire writes of `isPro: false` stay allowed.
    function isOwnerUpdate(userEmail) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return request.auth != null
          && request.auth.token.email == userEmail
          && !affected.hasAny(['isAdmin', 'referredBy'])
          && (!affected.hasAny(['trialEndDate']) || validTrialCap(d.trialEndDate))
          && (!affected.hasAny(['subscriptionStatus'])
              || (d.subscriptionStatus == 'pro'
                  ? validProClaim(d)
                  : (d.subscriptionStatus == 'pending'
                      || d.subscriptionStatus == 'free')))
          && (!affected.hasAny(['isPro']) || d.isPro == false || validProClaim(d));
    }

    // Owner records the referral code they applied to their own profile.
    function isReferralApplication(userEmail) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return request.auth != null
          && request.auth.token.email == userEmail
          && affected.hasOnly(['referredBy', 'trialEndDate'])
          && (!affected.hasAny(['trialEndDate'])
              || (d.trialEndDate is timestamp && validTrialCap(d.trialEndDate)));
    }

    // A user earns Pro by referring someone: only a write to a DIFFERENT
    // user's doc (the referrer, which has a referralCode) that increments the
    // referral count and grants a trial may set subscriptionStatus to 'pro'.
    function isReferralReward(userEmail) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return request.auth != null
          && userEmail != request.auth.token.email
          && resource.data.keys().hasAny(['referralCode'])
          && affected.hasOnly(['referralCount', 'subscriptionStatus', 'trialEndDate'])
          && d.subscriptionStatus == 'pro'
          && d.trialEndDate is timestamp
          && validTrialCap(d.trialEndDate)
          && d.referralCount is number
          && d.referralCount >= 0
          && d.referralCount < 10000;
    }

    // Admins manage other users' subscriptions (approve/reject) but cannot
    // mint new admins through this path.
    function isAdminUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && !affected.hasAny(['isAdmin']);
    }

    match /users/{userEmail} {
      allow read: if isOwner(userEmail) || isAdmin();
      // isAdmin must not be settable on create — otherwise a user could
      // delete + recreate their doc with isAdmin:true and read everyone's data.
      // The trial and pro caps mirror isOwnerUpdate so a doc delete+recreate
      // cannot bypass the 45-day trial limit or self-grant pro.
      allow create: if isOwner(userEmail)
          && !('isAdmin' in request.resource.data)
          && (!('trialEndDate' in request.resource.data)
              || validTrialCap(request.resource.data.trialEndDate))
          && (!('subscriptionStatus' in request.resource.data)
              || request.resource.data.subscriptionStatus == 'free'
              || request.resource.data.subscriptionStatus == 'pending'
              || validProClaim(request.resource.data))
          && (!('isPro' in request.resource.data)
              || request.resource.data.isPro == false
              || validProClaim(request.resource.data));
      allow update: if isOwnerUpdate(userEmail)
          || isReferralApplication(userEmail)
          || isReferralReward(userEmail)
          || isAdminUpdate();
      allow delete: if isOwner(userEmail);

      match /transactions/{txId} {
        allow read: if isOwner(userEmail) || isAdmin();
        allow write: if isOwner(userEmail) && (request.method == 'delete' || validTransaction());
      }

      match /categories/{catId} {
        allow read, write: if isOwner(userEmail);
      }

      match /budgets/{catId} {
        allow read, write: if isOwner(userEmail);
      }

      match /recurring_payments/{paymentId} {
        allow read, write: if isOwner(userEmail);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userEmail);
      }

      match /lent_money/{entryId} {
        allow read, write: if isOwner(userEmail);
      }

      match /wealth/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      match /category_rules/{ruleId} {
        allow read, write: if isOwner(userEmail);
      }

      match /learning_data/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userEmail);
      }

      match /loans/{loanId} {
        allow read, write: if isOwner(userEmail);
      }

      match /challenges/{challengeId} {
        allow read, write: if isOwner(userEmail);
      }

      // SMS import rules — must exist or account deletion / GDPR export
      // (which list this collection) are denied by the catch-all.
      match /sms_rules/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      // Per-asset subcollections for AssetDetailScreen
      match /{collection}/{docId} {
        allow read, write: if isOwner(userEmail) && collection in [
          // Liquid & Fixed Income
          'fd_accounts', 'ppf_accounts', 'post_office_schemes',
          'bonds', 'chit_funds',
          // Equity & Growth
          'stock_holdings', 'sip_holdings', 'etf_holdings',
          'foreign_stocks', 'startup_investments',
          // Retirement
          'pf_accounts', 'vpf_accounts', 'nps_accounts',
          // Alternative Assets
          'gold_holdings', 'sgb_holdings', 'jewelry_items',
          'crypto_holdings', 'reit_holdings', 'p2p_loans',
          // Physical Assets
          'agri_land', 'properties', 'vehicles',
          // Protection & Business
          'insurance_policies', 'business_assets',
          // Liabilities
          'bnpl_entries', 'credit_cards',
          // User data cleared by the GDPR delete flow
          'backups', 'insights', 'preferences', 'logs',
        ];
      }
    }

    // App Config — allow all authenticated users to read SMS rules, payment settings, etc.
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Referral codes. A code is a document keyed by the code itself, so
    // validating a code needs no collection query — the `users` rules grant
    // per-document reads only, which makes `where('referralCode', …)`
    // unprovable and therefore always denied.
    //
    // `get` (never `list`) is enough to validate a code someone already has,
    // so codes cannot be enumerated to harvest owners' email addresses.
    match /referralCodes/{code} {
      allow get: if request.auth != null;
      // `claims`/`credited` must start empty: the owner credits themselves a
      // trial per claim on their next login, so a seeded claim would be a
      // self-granted referral reward.
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.token.email
                    && request.resource.data.ownerUid == request.auth.uid
                    && (request.resource.data.claims == null
                        || request.resource.data.claims.size() == 0)
                    && (request.resource.data.credited == null
                        || request.resource.data.credited.size() == 0);
      // A referee may append exactly one claim — their own — and nothing else;
      // only the owner may change the rest of the document. Crediting the
      // referrer's trial happens in the referrer's own user document on their
      // next login, so no client ever writes to another user's document.
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.token.email
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
          && request.resource.data.claims is map
          // The appended entry must be the caller's own, or a client could
          // credit itself rewards on behalf of other users.
          && request.auth.uid in request.resource.data.claims
          && request.resource.data.claims[request.auth.uid] is timestamp
          && (
            (resource.data.claims == null
              && request.resource.data.claims.size() == 1)
            || (resource.data.claims is map
              && request.resource.data.claims.size() == resource.data.claims.size() + 1
              && request.resource.data.claims
                   .diff(resource.data.claims)
                   .affectedKeys()
                   .hasOnly([request.auth.uid]))
          )
        )
      );
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.token.email;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
