rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    function isAdmin() {
      let adminDoc = request.auth != null
          ? get(/databases/$(database)/documents/users/$(request.auth.token.email))
          : null;
      return request.auth != null
          && adminDoc != null
          && adminDoc.data.get('isAdmin', false) == true;
    }

    function validTrialCap(ts) {
      return ts is timestamp
          && ts.toMillis() - request.time.toMillis() <= (45 * 24 * 60 * 60 * 1000);
    }

    // A doc write may only claim 'pro' via a recorded Google Play purchase
    // (true purchase verification requires a Cloud Function).
    function validProClaim(d) {
      return d.subscriptionStatus == 'pro'
          && d.purchaseToken is string
          && d.purchaseToken.size() > 0;
    }

    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasAll(['amount', 'date', 'senderId', 'recipientId'])
          && d.amount is number
          && d.date is timestamp;
    }

    // The explicit "delete all my data" reset. The profile is rewritten with
    // merge:false, so gated fields (trialEndDate, subscriptionStatus, isPro,
    // referral bookkeeping) disappear. It is the only write allowed to remove
    // them; a plain update could otherwise drop trialEndDate and buy another
    // free trial, since the client derives trialUsed from the key's presence.
    //
    // Because this one branch may touch any field, it must also refuse to put a
    // gated value *back*: without those checks an "erase" was a general-purpose
    // write that could mint an admin (`isAdmin: true`) or a Pro entitlement
    // alongside the consent flags. The real erase writes email + the two
    // consent flags + dataDeletedAt and deletes everything else, so nothing
    // legitimate is lost.
    function isProfileErase(userEmail) {
      let d = request.resource.data;
      return request.auth != null
          && request.auth.token.email == userEmail
          && d.get('consent_data', true) == false
          && d.keys().hasAny(['dataDeletedAt'])
          // isAdmin may be dropped (an admin erasing their own data), never set.
          && (!d.get('isAdmin', false)
              || resource.data.get('isAdmin', false) == true)
          && !d.keys().hasAny(['trialEndDate'])
          && !d.keys().hasAny(['referralCredited'])
          && (!d.keys().hasAny(['isPro']) || d.isPro == false)
          && (!d.keys().hasAny(['subscriptionStatus'])
              || d.subscriptionStatus == 'free'
              || d.subscriptionStatus == 'pending');
    }

    // A free trial is granted once, for 7 days. The client derives trialUsed
    // from the presence of trialEndDate, so "no key yet" is exactly the
    // first-grant condition and the rule cannot drift from the UI.
    //
    // Ownership AND the changed-field set are both required: the update rule
    // ORs its branches, so an ownership check inside `isOwnerUpdate` alone left
    // this branch able to write *any* document — any signed-in user could
    // rewrite another account's profile, or smuggle `subscriptionStatus: pro`
    // and a purchase token into their own trial write.
    function isTrialStart(userEmail) {
      let end = request.resource.data.get('trialEndDate', null);
      return request.auth != null
          && request.auth.token.email == userEmail
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['trialEndDate'])
          && !resource.data.keys().hasAny(['trialEndDate'])
          && end is timestamp
          && end.toMillis() - request.time.toMillis()
              <= (7 * 24 * 60 * 60 * 1000) + (60 * 60 * 1000);
    }

    // After the grant, trialEndDate may only move earlier — that is what the
    // app's cancel/expire writes do. Anything later is a grant, and grants need
    // a claim (isClaimPayout) or a referral code this profile applied
    // (isReferralApplication).
    function isTrialShrink() {
      let old = resource.data.get('trialEndDate', timestamp.date(1970, 1, 1));
      let end = request.resource.data.get('trialEndDate', null);
      return end is timestamp && end.toMillis() <= old.toMillis();
    }

    // Owner update of their own profile. Blocks self-admin and self-referral
    // spoofing. 'pro' status can only be claimed via a recorded Google Play
    // purchase (true purchase verification requires a Cloud Function; this
    // closes the naive "write subscriptionStatus: pro" self-grant hole). The
    // parallel `isPro` flag is also gated: it may only be set true alongside a
    // valid pro claim (closing the "write isPro: true" self-grant hole), while
    // the app's own cancel/expire writes of `isPro: false` stay allowed.
    function isOwnerUpdate(userEmail) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return request.auth != null
          && request.auth.token.email == userEmail
          && !affected.hasAny(['isAdmin', 'referredBy', 'referralCredited'])
          // referralCount may be rewritten with the same value (ensuring a code
          // doc writes it back), but a real increment goes through
          // isClaimPayout, which needs a credited claim.
          && (!affected.hasAny(['referralCount'])
              || d.referralCount == resource.data.get('referralCount', 0))
          && (!affected.hasAny(['trialEndDate']) || isTrialShrink())
          && (!affected.hasAny(['subscriptionStatus'])
              || (d.subscriptionStatus == 'pro'
                  ? validProClaim(d)
                  : (d.subscriptionStatus == 'pending'
                      || d.subscriptionStatus == 'free')))
          && (!affected.hasAny(['isPro']) || d.isPro == false || validProClaim(d));
    }

    // The referee records the code they applied, plus their first month. The
    // code must exist, must not be the caller's own, and a profile can apply
    // only once: `referredBy` may not already be present. Without the once-only
    // check any client could re-apply a code and roll the 30 days forward
    // forever; without the code lookup, writing `referredBy` was enough.
    function isReferralApplication(userEmail) {
      let d = request.resource.data;
      let affected = d.diff(resource.data).affectedKeys();
      let codeDoc = get(/databases/$(database)/documents/referralCodes/$(d.get('referredBy', 'no-such-code')));
      let end = d.get('trialEndDate', null);
      return request.auth != null
          && request.auth.token.email == userEmail
          && affected.hasOnly(['referredBy', 'trialEndDate'])
          && !resource.data.keys().hasAny(['referredBy'])
          && codeDoc != null
          && codeDoc.data.get('ownerUid', '') != request.auth.uid
          && end is timestamp
          && end.toMillis() - request.time.toMillis()
              <= (30 * 24 * 60 * 60 * 1000) + (60 * 60 * 1000)
          && validTrialCap(end);
    }

    // The referral payout: converts claims that referees appended to the
    // referrer's referralCodes document into trial days, on the referrer's own
    // profile, in one write.
    //
    // The credited marker lives on the *user* document (`referralCredited`) on
    // purpose. It is what makes a claim payable exactly once: the rule sees the
    // before/after state of the document it validates, so a uid already listed
    // there cannot fund a second extension. Recording the credit only on the
    // code document (where a rule for the user document cannot see it) let a
    // modified client pay out over and over without ever writing the marker.
    function isClaimPayout(userEmail) {
      let d = request.resource.data;
      let affected = d.diff(resource.data).affectedKeys();
      let codeDoc = get(/databases/$(database)/documents/referralCodes/$(resource.data.get('referralCode', 'no-such-code')));
      let claims = codeDoc == null ? {} : codeDoc.data.get('claims', {});
      let before = resource.data.get('referralCredited', {});
      let after = d.get('referralCredited', {});
      let added = after.diff(before).addedKeys();
      let old = resource.data.get('trialEndDate', timestamp.date(1970, 1, 1));
      let base = old.toMillis() > request.time.toMillis()
          ? old.toMillis()
          : request.time.toMillis();
      return request.auth != null
          && request.auth.token.email == userEmail
          && codeDoc != null
          && codeDoc.data.get('ownerUid', '') == request.auth.uid
          && affected.hasOnly(['referralCount', 'trialEndDate', 'referralCredited'])
          && after is map
          // Credits are add-only: dropping one would make it payable again.
          && after.diff(before).removedKeys().size() == 0
          && added.size() > 0
          // Every newly credited uid must be a real claim on this code. Adding
          // a key that is not a claim would not shrink the outstanding set by
          // one, so this equality only holds when added ⊆ claims.
          && claims.diff(after).addedKeys().size()
              == claims.diff(before).addedKeys().size() - added.size()
          && d.get('trialEndDate', null) is timestamp
          && validTrialCap(d.trialEndDate)
          && d.trialEndDate.toMillis() <= base
              + added.size() * (30 * 24 * 60 * 60 * 1000)
              + (60 * 60 * 1000)
          // referralCount moves by at most one per credited claim.
          && (!affected.hasAny(['referralCount'])
              || (d.referralCount is number
                  && d.referralCount >= resource.data.get('referralCount', 0)
                  && d.referralCount
                      <= resource.data.get('referralCount', 0) + added.size()));
    }

    // Admins manage other users' subscriptions (approve/reject) but cannot
    // mint new admins through this path.
    function isAdminUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && !affected.hasAny(['isAdmin']);
    }

    match /users/{userEmail} {
      allow read: if isOwner(userEmail) || isAdmin();
      // isAdmin must not be settable on create — otherwise a user could
      // delete + recreate their doc with isAdmin:true and read everyone's data.
      // A created profile may only carry the 7-day first trial (a 45-day one
      // was a free Pro grant), and 'pro' still needs a purchase claim.
      allow create: if isOwner(userEmail)
          && !('isAdmin' in request.resource.data)
          && !('referralCredited' in request.resource.data)
          && (!('trialEndDate' in request.resource.data)
              || (request.resource.data.trialEndDate is timestamp
                  && request.resource.data.trialEndDate.toMillis()
                      - request.time.toMillis()
                      <= (7 * 24 * 60 * 60 * 1000) + (60 * 60 * 1000)))
          && (!('subscriptionStatus' in request.resource.data)
              || request.resource.data.subscriptionStatus == 'free'
              || request.resource.data.subscriptionStatus == 'pending'
              || validProClaim(request.resource.data))
          && (!('isPro' in request.resource.data)
              || request.resource.data.isPro == false
              || validProClaim(request.resource.data));
      allow update: if isOwnerUpdate(userEmail)
          || isTrialStart(userEmail)
          || isProfileErase(userEmail)
          || isReferralApplication(userEmail)
          || isClaimPayout(userEmail)
          || isAdminUpdate();
      allow delete: if isOwner(userEmail);

      // Deletion marker. `deleteAccount` writes exactly this one document after
      // every data subcollection is gone, so a deletion that is interrupted
      // before the auth user is removed can be finished on the next sign-in
      // (`UserService.resumeInterruptedDeletion`) instead of leaving a
      // half-deleted account behind. The uid must be the caller's own: a marker
      // replayed against a different account (same email, new uid — delete then
      // sign up again) must not be able to finish/erase that account.
      // Delete is allowed so the stale tombstone can be cleared, and there is
      // deliberately no update branch.
      match /meta/deletion {
        allow read, delete: if isOwner(userEmail);
        allow create: if isOwner(userEmail)
            && request.resource.data.keys().hasOnly(['uid', 'startedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.startedAt is timestamp;
      }

      match /transactions/{txId} {
        allow read: if isOwner(userEmail) || isAdmin();
        allow write: if isOwner(userEmail) && (request.method == 'delete' || validTransaction());
      }

      match /categories/{catId} {
        allow read, write: if isOwner(userEmail);
      }

      match /budgets/{catId} {
        allow read, write: if isOwner(userEmail);
      }

      match /recurring_payments/{paymentId} {
        allow read, write: if isOwner(userEmail);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userEmail);
      }

      match /lent_money/{entryId} {
        allow read, write: if isOwner(userEmail);
      }

      match /wealth/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      match /category_rules/{ruleId} {
        allow read, write: if isOwner(userEmail);
      }

      match /learning_data/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userEmail);
      }

      match /loans/{loanId} {
        allow read, write: if isOwner(userEmail);
      }

      match /challenges/{challengeId} {
        allow read, write: if isOwner(userEmail);
      }

      // SMS import rules — must exist or account deletion / GDPR export
      // (which list this collection) are denied by the catch-all.
      match /sms_rules/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      // Per-asset subcollections for AssetDetailScreen
      match /{collection}/{docId} {
        allow read, write: if isOwner(userEmail) && collection in [
          // Liquid & Fixed Income
          'fd_accounts', 'ppf_accounts', 'post_office_schemes',
          'bonds', 'chit_funds',
          // Equity & Growth
          'stock_holdings', 'sip_holdings', 'etf_holdings',
          'foreign_stocks', 'startup_investments',
          // Retirement
          'pf_accounts', 'vpf_accounts', 'nps_accounts',
          // Alternative Assets
          'gold_holdings', 'sgb_holdings', 'jewelry_items',
          'crypto_holdings', 'reit_holdings', 'p2p_loans',
          // Physical Assets
          'agri_land', 'properties', 'vehicles',
          // Protection & Business
          'insurance_policies', 'business_assets',
          // Liabilities
          'bnpl_entries', 'credit_cards',
          // User data cleared by the GDPR delete flow
          'backups', 'insights', 'preferences', 'logs',
        ];
      }
    }

    // App Config — restrict reads to admins to avoid exposing internal config.
    match /app_config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Referral codes. A code is a document keyed by the code itself, so
    // validating a code needs no collection query — the `users` rules grant
    // per-document reads only, which makes `where('referralCode', …)`
    // unprovable and therefore always denied.
    //
    // `get` (never `list`) is enough to validate a code someone already has,
    // so codes cannot be enumerated to harvest owners' email addresses.
    match /referralCodes/{code} {
      allow get: if request.auth != null;
      // `claims`/`credited` must start empty: the owner credits themselves a
      // trial per claim on their next login, so a seeded claim would be a
      // self-granted referral reward.
      //
      // New documents are owned by uid only: anyone who knows a code can read
      // it, so storing the owner's email handed out their address. Documents
      // created by older builds still carry `owner`, and it must identify the
      // same person.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && (!request.resource.data.keys().hasAny(['owner'])
                        || request.resource.data.owner == request.auth.token.email)
                    && (!request.resource.data.keys().hasAny(['claims'])
                        || request.resource.data.claims.size() == 0)
                    && (!request.resource.data.keys().hasAny(['credited'])
                        || request.resource.data.credited.size() == 0);
      // A referee may append exactly one claim — their own — and nothing else,
      // and never to their own code. The owner may only append to `credited`:
      // clearing an entry would make that claim payable a second time.
      allow update: if request.auth != null && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credited'])
          && request.resource.data.credited is map
          && request.resource.data.credited
               .diff(resource.data.get('credited', {}))
               .removedKeys().size() == 0
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
          && resource.data.ownerUid != request.auth.uid
          && request.resource.data.claims is map
          // The appended entry must be the caller's own, or a client could
          // credit itself rewards on behalf of other users.
          && request.auth.uid in request.resource.data.claims
          && request.resource.data.claims[request.auth.uid] is timestamp
          && (
            (!resource.data.keys().hasAny(['claims'])
              && request.resource.data.claims.size() == 1)
            || (resource.data.keys().hasAny(['claims'])
              && resource.data.claims is map
              && request.resource.data.claims.size() == resource.data.claims.size() + 1
              && request.resource.data.claims
                   .diff(resource.data.claims)
                   .affectedKeys()
                   .hasOnly([request.auth.uid]))
          )
        )
      );
      allow delete: if request.auth != null
                    && (resource.data.get('ownerUid', '') == request.auth.uid
                        || resource.data.get('owner', '') == request.auth.token.email);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
