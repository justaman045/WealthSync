rules_version = '2';

// Firebase Storage rules for WealthSync — DORMANT.
//
// Nothing writes here today: Cloud Storage requires the Blaze plan, this project
// stays on Spark, no bucket exists, and the profile-picture upload affordance was
// removed. The avatar shown in the app is the sign-in provider's `photoURL`
// (Google-hosted) or the bundled placeholder asset.
//
// The file is kept as a reviewed starting point and is still exercised by the
// Storage emulator in `tool/rules_tests/run.sh`, but it is NOT deployed by CI:
// `--only storage` aborts with "Firebase Storage has not been set up", and adding
// it to the deploy job would abort the Firestore rules deploy with it (see
// AGENTS.md and test/ci_workflow_contract_test.dart).
//
// The path segment is the **Firebase Auth UID**, so ownership is enforced by
// comparing it to `request.auth.uid` — never by email, which is mutable and is
// why the Firestore rules use `token.email` only for `users/{email}` paths.
//
// If Storage is ever enabled, the intended shape is one object per user:
// `users/{uid}/profile.jpg` — owner read/delete, create/update bounded by
// content type and size (see the match block below).
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{fileName} {
      // The app displays the picture through its tokenized download URL (which
      // does not consult these rules); direct SDK reads stay owner-only.
      allow read: if isOwner(uid);

      // `request.resource` is null on delete, so the metadata checks below must
      // not apply to this branch — account deletion removes the picture.
      allow delete: if isOwner(uid);

      // create/update see the incoming object's metadata.
      allow create, update: if isOwner(uid)
          && fileName == 'profile.jpg'
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Everything else is denied. Default-deny is implicit in Storage rules;
    // this block exists so the intent is explicit and a future path cannot be
    // added by accident above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
